# Copy to flaskr/.env (local runs) or .env at the repo root (docker compose) and fill in.

# Central database with users, organizations (tenants), roles and permissions
USERS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/emonitoring_users
# Server URL without a database name; each organization gets its own database "<tenant uuid>"
GENERAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432

# Use long random values, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
SECRET_KEY=change-me
JWT_EXPIRES_MINUTES=480

# Gmail address + app password used to send email verification codes
SENDER_EMAIL=
SENDER_PASSWORD=

# Optional
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Where uploaded faces, alert screenshots and zone masks are stored (default: flaskr/static)
STORAGE_PATH=
